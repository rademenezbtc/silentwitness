diff --git a/tests/spike_sp.rs b/tests/spike_sp.rs
new file mode 100644
index 0000000..353bdae
--- /dev/null
+++ b/tests/spike_sp.rs
@@ -0,0 +1,48 @@
+#![cfg(feature = "simulator")]
+mod util;
+use bitbox_api::pb;
+use std::collections::BTreeMap;
+use util::test_initialized_simulators_with_stdout;
+
+#[tokio::test]
+async fn spike_silent_payment() {
+    let file: serde_json::Value =
+        serde_json::from_str(include_str!("data/btc-transaction-test-vectors.json")).unwrap();
+    let v = file["vectors"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|v| v["id"] == "silent-payment")
+        .unwrap();
+    let psbt_hex = v["psbt"]["transaction"].as_str().unwrap();
+    let addr = v["psbt"]["options"]["outputs"]["1"]["silent_payment_address"]
+        .as_str()
+        .unwrap()
+        .to_string();
+    test_initialized_simulators_with_stdout(async |bitbox, stdout| {
+        let cp = stdout.checkpoint();
+        let mut psbt = bitcoin::psbt::Psbt::deserialize(&hex::decode(psbt_hex).unwrap()).unwrap();
+        let mut sp = BTreeMap::new();
+        sp.insert(1usize, addr.clone());
+        println!("SPIKE firmware version: {}", bitbox.version());
+        let r = bitbox
+            .btc_sign_psbt_sp(
+                pb::BtcCoin::Btc,
+                &mut psbt,
+                None,
+                pb::btc_sign_init_request::FormatUnit::Default,
+                &sp,
+            )
+            .await;
+        println!(
+            "SPIKE result: {:?}",
+            r.as_ref().map(|g| g
+                .iter()
+                .map(|o| (o.output_index, hex::encode(&o.pkscript), hex::encode(&o.dleq_proof)))
+                .collect::<Vec<_>>())
+        );
+        std::thread::sleep(std::time::Duration::from_millis(1500));
+        println!("SPIKE screens:\n{}", stdout.snapshot(cp).raw());
+    })
+    .await;
+}
